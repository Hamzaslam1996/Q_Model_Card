{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Card",
  "description": "Schema for quantum model card metadata",
  "type": "object",
  "required": ["name", "version", "type"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the quantum model"
    },
    "version": {
      "type": "string",
      "description": "Version of the model"
    },
    "type": {
      "type": "string",
      "description": "Type of quantum model",
      "enum": ["algorithm", "circuit", "hardware", "simulator", "other"]
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the model"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "qubits": {
          "type": "integer",
          "minimum": 1
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "errorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
