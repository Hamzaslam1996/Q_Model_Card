{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quantum Model Card (Everitt 2024)",
  "type": "object",
  "required": ["metadata", "sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["entityName", "entityType", "technologyDomain"],
      "properties": {
        "entityName": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "type": "string",
          "minLength": 1
        },
        "technologyDomain": {
          "type": "string",
          "minLength": 1
        },
        "uploadedFileId": {
          "type": ["string", "null"]
        },
        "uploadedFileSize": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"],
      "properties": {
        "A": { "$ref": "#/$defs/section" },
        "B": { "$ref": "#/$defs/section" },
        "C": { "$ref": "#/$defs/section" },
        "D": { "$ref": "#/$defs/section" },
        "E": { "$ref": "#/$defs/section" },
        "F": { "$ref": "#/$defs/section" },
        "G": { "$ref": "#/$defs/section" },
        "H": { "$ref": "#/$defs/section" },
        "I": { "$ref": "#/$defs/section" },
        "J": { "$ref": "#/$defs/section" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "body"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-J]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
